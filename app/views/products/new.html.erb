<div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-md mt-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Nuevo Producto</h1>
    <%= link_to "Crear Nueva Categoría", new_category_path, class: "text-sm text-blue-600 hover:underline font-medium" %>
  </div>

  <%= form_with(model: @product, local: true, class: "space-y-4") do |form| %>
    <% if @product.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm">
        <h2 class="font-bold"><%= pluralize(@product.errors.count, "error") %> impidieron guardar este producto:</h2>
        <ul class="list-disc pl-5 mt-2">
          <% @product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nombre del Producto", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :sku, "SKU / Código", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :sku, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :category_id, "Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Selecciona una categoría" }, { class: "w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <%= form.label :price, "Precio ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :price, step: "0.01", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :stock, "Stock Inicial", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :stock, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :low_stock_threshold, "Alerta Stock Bajo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :low_stock_threshold, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex items-center justify-between pt-4">
      <%= form.submit "Guardar Producto", class: "bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition cursor-pointer" %>
      <%= link_to "Cancelar", products_path, class: "text-gray-600 hover:text-gray-800 text-sm font-medium" %>
    </div>
  <% end %>
</div>