<div class="space-y-6">
  <!-- Cabecera y Filtros -->
  <div class="flex flex-col md:flex-row justify-between items-center gap-4 bg-white p-4 rounded-lg shadow-sm border border-gray-100">
    <h2 class="text-2xl font-bold text-gray-800">Control de Inventario</h2>

    <!-- Buscador y Filtros -->
    <%= form_with url: products_path, method: :get, local: true, class: "flex flex-wrap gap-2 w-full md:w-auto" do %>
      <%= text_field_tag :query, params[:query], placeholder: "Buscar por nombre o SKU...", class: "rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
      
      <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: "Todas las categorías", class: "rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
      
      <%= submit_tag "Filtrar", class: "bg-gray-800 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700 cursor-pointer" %>
      
      <% if params[:query].present? || params[:category_id].present? %>
        <%= link_to "Limpiar", products_path, class: "bg-gray-100 text-gray-700 px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-200 flex items-center" %>
      <% end %>
    <% end %>
  </div>

  <!-- Tabla de Productos -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SKU / Producto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @products.each do |product| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-gray-900"><%= product.name %></div>
                <div class="text-xs text-gray-500 font-mono"><%= product.sku %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700">
                  <%= product.category&.name || "Sin categoría" %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                $<%= number_with_precision(product.price, precision: 2) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <div class="flex items-center justify-center space-x-2">
                  <%= button_to "-1", adjust_stock_product_path(product, change: -1), method: :patch, class: "w-7 h-7 bg-red-100 text-red-600 rounded font-bold hover:bg-red-200 flex items-center justify-center text-xs" %>
                  
                  <span class="text-sm font-bold px-2 py-0.5 rounded <%= product.low_stock? ? 'bg-red-100 text-red-800 animate-pulse' : 'text-gray-900' %>">
                    <%= product.stock %>
                  </span>
                  
                  <%= button_to "+1", adjust_stock_product_path(product, change: 1), method: :patch, class: "w-7 h-7 bg-green-100 text-green-600 rounded font-bold hover:bg-green-200 flex items-center justify-center text-xs" %>
                </div>
                <% if product.low_stock? %>
                  <span class="text-[10px] text-red-600 font-semibold block mt-1">¡Stock Bajo!</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <span class="px-2 py-1 text-xs font-semibold rounded-full <%= product.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= product.active? ? 'Activo' : 'Inactivo' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                <%= link_to "Editar", edit_product_path(product), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "Eliminar", product_path(product), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar este producto?" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
          <% if @products.empty? %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">
                No se encontraron productos registrados.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>