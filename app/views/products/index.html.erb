<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Cabecera de la página -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Panel de Inventario</h1>
      <p class="text-sm text-gray-600">Administra tus productos, categorías y stock en tiempo real.</p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Nueva Categoría", new_category_path, class: "bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 shadow-sm" %>
      <%= link_to "Nuevo Producto", new_product_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 shadow-sm" %>
    </div>
  </div>

  <!-- Avisos / Notificaciones -->
  <% if notice.present? %>
    <div class="mb-4 bg-green-50 border-l-4 border-green-400 p-4 text-green-700 text-sm rounded shadow-sm">
      <%= notice %>
    </div>
  <% end %>

  <!-- Formulario de Búsqueda y Filtros -->
  <div class="mb-6 bg-white p-4 rounded-lg border border-gray-200 shadow-sm">
    <%= form_with url: products_path, method: :get, class: "flex flex-wrap gap-4 items-center justify-between" do |f| %>
      <div class="flex flex-wrap gap-3 items-center flex-1">
        <!-- Input de búsqueda por nombre o SKU -->
        <div class="flex-1 min-w-[240px]">
          <%= f.text_field :query, value: params[:query], placeholder: "Buscar por nombre o SKU...", class: "w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Selector de Categoría -->
        <div class="min-w-[200px]">
          <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Todas las categorías" }, class: "w-full rounded-md border-gray-300 shadow-sm px-3 py-2 border text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Botón Filtrar -->
        <div>
          <%= f.submit "Filtrar", class: "bg-indigo-600 text-white px-4 py-2 rounded-md shadow-sm text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
        </div>

        <!-- Botón Limpiar filtros -->
        <% if params[:query].present? || params[:category_id].present? %>
          <div>
            <%= link_to "Limpiar", products_path, class: "text-sm text-gray-600 underline hover:text-gray-900" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Tabla de Productos -->
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto / SKU</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @products.each do |product| %>
          <tr id="<%= dom_id(product) %>" class="hover:bg-gray-50">
            <!-- Nombre, SKU y Descripción -->
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= product.name %></div>
              <div class="text-xs text-gray-500">SKU: <%= product.sku %></div>
              <% if product.description.present? %>
                <div class="text-xs text-gray-400 mt-1 max-w-xs truncate" title="<%= product.description %>">
                  <%= product.description %>
                </div>
              <% end %>
            </td>

            <!-- Categoría -->
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2.5 py-0.5 inline-flex text-xs font-medium bg-gray-100 text-gray-800 rounded-full">
                <%= product.category.name %>
              </span>
            </td>

            <!-- Precio -->
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              $<%= number_with_precision(product.price, precision: 2) %>
            </td>

            <!-- Stock con Alerta condicional -->
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center space-x-2">
                <!-- Botón restar stock -->
                <%= button_to "-", adjust_stock_product_path(product, change: -1), method: :patch, class: "w-7 h-7 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded flex items-center justify-center font-bold text-sm shadow-sm" %>
                
                <!-- Cantidad y alerta visual -->
                <span class="px-2 py-1 text-sm font-semibold rounded <%= product.low_stock? ? 'bg-red-100 text-red-700 animate-pulse' : 'text-gray-900' %>">
                  <%= product.stock %>
                </span>

                <!-- Botón sumar stock -->
                <%= button_to "+", adjust_stock_product_path(product, change: 1), method: :patch, class: "w-7 h-7 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded flex items-center justify-center font-bold text-sm shadow-sm" %>
              </div>
              <% if product.low_stock? %>
                <span class="text-[10px] text-red-600 font-medium block mt-1">¡Stock bajo!</span>
              <% end %>
            </td>

            <!-- Acciones de edición -->
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
              <%= link_to "Editar", edit_product_path(product), class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "Eliminar", product_path(product), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro?" }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
        
        <% if @products.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500">
              No se encontraron productos que coincidan con la búsqueda.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>