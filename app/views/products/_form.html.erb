<%= form_with(model: product, local: true, class: "space-y-6") do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 text-red-700 text-sm">
      <p class="font-bold">Hay errores en el formulario:</p>
      <ul class="list-disc pl-5 mt-1">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :name, "Nombre del Producto", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :sku, "SKU (Código)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :sku, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :description, "Descripción", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :category_id, "Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :category_id, categories, :id, :name, { prompt: "Seleccione una categoría" }, { class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" } %>
    </div>

    <div>
      <%= f.label :price, "Precio ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :price, step: "0.01", class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :stock, "Stock Inicial", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :stock, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :low_stock_threshold, "Umbral de Stock Bajo", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :low_stock_threshold, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="md:col-span-2 flex items-center space-x-3 pt-2">
      <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
      <%= f.label :active, "Producto Activo / Visible", class: "text-sm font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
    <%= link_to "Cancelar", products_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200" %>
    <%= f.submit "Guardar Producto", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 shadow" %>
  </div>
<% end %>