<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md mt-10">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">Nueva Categoría</h1>

  <%= form_with(model: @category, local: true, class: "space-y-4") do |form| %>
    <% if @category.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm">
        <h2 class="font-bold"><%= pluralize(@category.errors.count, "error") %> impidieron guardar esta categoría:</h2>
        <ul class="list-disc pl-5 mt-2">
          <% @category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nombre de la Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="flex items-center justify-between pt-4">
      <%= form.submit "Guardar Categoría", class: "bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition cursor-pointer" %>
      <%= link_to "Cancelar", products_path, class: "text-gray-600 hover:text-gray-800 text-sm font-medium" %>
    </div>
  <% end %>
</div>