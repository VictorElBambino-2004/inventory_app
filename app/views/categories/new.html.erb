<div class="max-w-md mx-auto space-y-6">
  <!-- Formulario de Creación -->
  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">Nueva Categoría</h2>

    <%= form_with(model: @category, local: true, class: "space-y-4") do |f| %>
      <% if @category.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4 text-red-700 text-sm">
          <p class="font-bold">Por favor corrige los siguientes errores:</p>
          <ul class="list-disc pl-5 mt-1">
            <% @category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Nombre de la Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Ej. Electrónica, Ropa..." %>
      </div>

      <div class="flex justify-end space-x-3 pt-4">
        <%= link_to "Cancelar", root_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200" %>
        <%= f.submit "Guardar Categoría", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 shadow" %>
      </div>
    <% end %>
  </div>

  <!-- Listado de Categorías Existentes -->
  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
    <h3 class="text-lg font-bold mb-4 text-gray-800">Categorías Existentes</h3>
    <ul class="divide-y divide-gray-200">
      <% Category.all.each do |category| %>
        <li class="py-3 flex justify-between items-center">
          <span class="text-sm font-medium text-gray-700"><%= category.name %></span>
          <%= link_to "Eliminar", category_path(category), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro? Al eliminar esta categoría, es posible que los productos asociados pierdan su referencia o se eliminen." }, class: "text-xs text-red-600 hover:text-red-900 font-medium" %>
        </li>
      <% end %>
      <% if Category.count.zero? %>
        <p class="text-xs text-gray-500">No hay categorías registradas aún.</p>
      <% end %>
    </ul>
  </div>
</div>